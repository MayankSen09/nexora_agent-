{
  "name": "nexora",
  "version": "1.0.0",
  "private": true,
  "description": "NEXORA — Autonomous Intelligence for Onchain Markets",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev:api": "bun --cwd apps/api dev",
    "dev:web": "bun --cwd apps/web dev",
    "test": "bun test packages/*/src/**/__tests__/*.test.ts tests/*.test.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
